          },
          {
            "spell": "spell:confusion",
            "name": "Confusion",
            "casting": "always prepared",
            "list": "druid"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-spores-spells-9",
