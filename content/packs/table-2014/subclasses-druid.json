    {
      "kind": "subclass",
      "id": "subclass:circle-of-the-moon",
      "name": "Circle of the Moon",
      "summary": "Shapechanging druid who fights in powerful beast and elemental forms.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 68
      },
      "class": "class:druid",
      "features": [
        {
          "level": 2,
          "feature": "feature:circle-of-the-moon-combat-wild-shape"
        },
        {
          "level": 2,
          "feature": "feature:circle-of-the-moon-circle-forms"
        },
        {
          "level": 6,
          "feature": "feature:circle-of-the-moon-primal-strike"
        },
        {
          "level": 10,
          "feature": "feature:circle-of-the-moon-elemental-wild-shape"
        },
        {
          "level": 14,
          "feature": "feature:circle-of-the-moon-thousand-forms"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-moon-combat-wild-shape",
      "name": "Combat Wild Shape",
      "summary": "Wild Shape takes a bonus action. While transformed, a bonus action and a spell slot heal you 1d8 per slot level.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 69
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-moon-circle-forms",
      "name": "Circle Forms",
      "summary": "Wild Shape into beasts of CR 1 from 2nd level; from 6th level, up to your druid level divided by 3 (rounded down). Flying and swimming limits still apply.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 69
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-moon-primal-strike",
      "name": "Primal Strike",
      "summary": "Your attacks in beast form count as magical for overcoming resistance and immunity.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 69
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-moon-elemental-wild-shape",
      "name": "Elemental Wild Shape",
      "summary": "Spend two Wild Shape uses at once to become an air, earth, fire or water elemental.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 69
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-moon-thousand-forms",
      "name": "Thousand Forms",
      "summary": "Cast Alter Self at will.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 69
      },
      "grant": {
        "spells": [
          {
            "spell": "spell:alter-self",
            "name": "Alter Self",
            "casting": "at will",
            "list": "druid",
            "atWill": true
          }
        ]
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:circle-of-dreams",
      "name": "Circle of Dreams",
      "summary": "Fey-touched druid who heals with summer light, guards camps and steps through hidden paths.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 22
      },
      "class": "class:druid",
      "features": [
        {
          "level": 2,
          "feature": "feature:circle-of-dreams-balm-of-the-summer-court"
        },
        {
          "level": 6,
          "feature": "feature:circle-of-dreams-hearth-of-moonlight-and-shadow"
        },
        {
          "level": 10,
          "feature": "feature:circle-of-dreams-hidden-paths"
        },
        {
          "level": 14,
          "feature": "feature:circle-of-dreams-walker-in-dreams"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-dreams-balm-of-the-summer-court",
      "name": "Balm of the Summer Court",
      "summary": "A pool of d6s equal to your druid level, refilled on a long rest. Bonus action: spend up to half your druid level in dice on a creature within 120 ft; it regains the total rolled plus 1 temporary hit point per die.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 22
      },
      "grant": {
        "resources": [
          {
            "id": "balm-of-the-summer-court",
            "name": "Balm of the Summer Court",
            "max": "classLevel.class:druid",
            "reset": "long",
            "die": "d6"
          }
        ],
        "actions": [
          {
            "id": "balm-of-the-summer-court",
            "name": "Balm of the Summer Court",
            "economy": "bonus",
            "cost": {
              "resource": "balm-of-the-summer-court"
            },
            "spendAmount": {
              "label": "Dice to spend"
            },
            "note": "Creature within 120 ft: roll the spent d6s and heal that much, plus 1 temp HP per die. Max dice: half your druid level."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-dreams-hearth-of-moonlight-and-shadow",
      "name": "Hearth of Moonlight and Shadow",
      "summary": "During a short or long rest, ward a 30-ft sphere: you and allies in it get +5 to Stealth and Perception checks, and its light is hidden from outside.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 22
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.check.skill.stealth",
            "op": "add",
            "value": 5,
            "mode": "suggested",
            "label": "Hearth of Moonlight and Shadow",
            "when": {
              "text": "resting inside your warded sphere"
            }
          },
          {
            "selector": "roll.check.skill.perception",
            "op": "add",
            "value": 5,
            "mode": "suggested",
            "label": "Hearth of Moonlight and Shadow",
            "when": {
              "text": "resting inside your warded sphere"
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-dreams-hidden-paths",
      "name": "Hidden Paths",
      "summary": "Bonus action: teleport up to 60 ft to a space you can see; or action: teleport a willing creature you touch up to 30 ft. Uses equal your Wisdom modifier (min 1) per long rest.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 23
      },
      "grant": {
        "resources": [
          {
            "id": "hidden-paths",
            "name": "Hidden Paths",
            "max": "mod.wis",
            "reset": "long",
            "min": 1
          }
        ],
        "actions": [
          {
            "id": "hidden-paths",
            "name": "Hidden Paths",
            "economy": "bonus",
            "cost": {
              "resource": "hidden-paths"
            },
            "note": "Teleport yourself up to 60 ft (bonus action), or a touched willing creature 30 ft (action)."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-dreams-walker-in-dreams",
      "name": "Walker in Dreams",
      "summary": "After a short rest, cast Dream, Scrying or Teleportation Circle (to the last place you took a long rest) without a slot or material components. Once per long rest.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 23
      },
      "grant": {
        "resources": [
          {
            "id": "walker-in-dreams",
            "name": "Walker in Dreams",
            "max": 1,
            "reset": "long"
          }
        ],
        "spells": [
          {
            "spell": "spell:dream",
            "name": "Dream",
            "casting": "once per long rest, after a short rest, without a slot",
            "resource": "walker-in-dreams",
            "list": "druid"
          },
          {
            "spell": "spell:scrying",
            "name": "Scrying",
            "casting": "once per long rest, after a short rest, without a slot",
            "resource": "walker-in-dreams",
            "list": "druid"
          },
          {
            "spell": "spell:teleportation-circle",
            "name": "Teleportation Circle",
            "casting": "once per long rest, after a short rest, without a slot",
            "resource": "walker-in-dreams",
            "list": "druid"
          }
        ]
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:circle-of-the-shepherd",
      "name": "Circle of the Shepherd",
      "summary": "Druid of beasts and fey spirits who empowers allies with a spirit totem and bolsters summons.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 23
      },
      "class": "class:druid",
      "features": [
        {
          "level": 2,
          "feature": "feature:circle-of-the-shepherd-speech-of-the-woods"
        },
        {
          "level": 2,
          "feature": "feature:circle-of-the-shepherd-spirit-totem"
        },
        {
          "level": 6,
          "feature": "feature:circle-of-the-shepherd-mighty-summoner"
        },
        {
          "level": 10,
          "feature": "feature:circle-of-the-shepherd-guardian-spirit"
        },
        {
          "level": 14,
          "feature": "feature:circle-of-the-shepherd-faithful-summons"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-shepherd-speech-of-the-woods",
      "name": "Speech of the Woods",
      "summary": "You learn Sylvan, and beasts can understand your speech while you can decipher theirs.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 23
      },
      "grant": {
        "proficiencies": [
          {
            "kind": "language",
            "target": "Sylvan"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-shepherd-spirit-totem",
      "name": "Spirit Totem",
      "summary": "Bonus action: summon a bear, hawk or unicorn spirit within 60 ft for 1 minute, with a 30-ft aura. Bear: temp HP 5 + druid level to chosen creatures and advantage on Strength checks and saves. Hawk: reaction to give advantage on an attack against a target in the aura, plus advantage on Perception. Unicorn: advantage on checks to detect creatures; your slot healing spells also heal everyone in the aura by your druid level. Once per short or long rest.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 24
      },
      "grant": {
        "resources": [
          {
            "id": "spirit-totem",
            "name": "Spirit Totem",
            "max": 1,
            "reset": "short"
          }
        ],
        "actions": [
          {
            "id": "spirit-totem",
            "name": "Spirit Totem",
            "economy": "bonus",
            "cost": {
              "resource": "spirit-totem"
            },
            "choose": {
              "label": "Spirit",
              "options": [
                "Bear",
                "Hawk",
                "Unicorn"
              ]
            },
            "toggles": [
              "spirit-totem"
            ],
            "duration": {
              "minutes": 1
            },
            "note": "Summon a spirit within 60 ft for 1 minute (30-ft aura). Bonus action: move it 60 ft."
          },
          {
            "id": "spirit-totem-hawk",
            "name": "Hawk Spirit",
            "economy": "reaction",
            "note": "A creature attacks a target inside the hawk aura: give it advantage."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-shepherd-mighty-summoner",
      "name": "Mighty Summoner",
      "summary": "Beasts and fey you summon or create with a spell get 2 extra hit points per Hit Die, and their natural weapons count as magical.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 24
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-shepherd-guardian-spirit",
      "name": "Guardian Spirit",
      "summary": "Beasts and fey you summoned that end their turn in your Spirit Totem aura regain hit points equal to half your druid level.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 24
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-the-shepherd-faithful-summons",
      "name": "Faithful Summons",
      "summary": "When you drop to 0 hit points or are incapacitated against your will, you can immediately get the effect of Conjure Animals at 9th level: four protective beasts of CR 2 or lower for 1 hour. Once per long rest.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 24
      },
      "grant": {
        "resources": [
          {
            "id": "faithful-summons",
            "name": "Faithful Summons",
            "max": 1,
            "reset": "long"
          }
        ],
        "actions": [
          {
            "id": "faithful-summons",
            "name": "Faithful Summons",
            "economy": "free",
            "cost": {
              "resource": "faithful-summons"
            },
            "note": "On dropping to 0 HP or being incapacitated: four CR 2 beasts appear to protect you for 1 hour (no concentration)."
          }
        ]
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:circle-of-spores",
      "name": "Circle of Spores",
      "summary": "Fungal druid who wraps itself in necrotic spores and raises the fallen as zombie servants.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 35
      },
      "class": "class:druid",
      "features": [
        {
          "level": 2,
          "feature": "feature:circle-of-spores-circle-spells-2"
        },
        {
          "level": 3,
          "feature": "feature:circle-of-spores-spells-3"
        },
        {
          "level": 5,
          "feature": "feature:circle-of-spores-spells-5"
        },
        {
          "level": 7,
          "feature": "feature:circle-of-spores-spells-7"
        },
        {
          "level": 9,
          "feature": "feature:circle-of-spores-spells-9"
        },
        {
          "level": 2,
          "feature": "feature:circle-of-spores-halo-of-spores"
        },
        {
          "level": 2,
          "feature": "feature:circle-of-spores-symbiotic-entity"
        },
        {
          "level": 6,
          "feature": "feature:circle-of-spores-fungal-infestation"
        },
        {
          "level": 10,
          "feature": "feature:circle-of-spores-spreading-spores"
        },
        {
          "level": 14,
          "feature": "feature:circle-of-spores-fungal-body"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-spores-circle-spells-2",
      "name": "Circle Spells",
      "summary": "You know the Chill Touch cantrip, and gain always-prepared circle spells at 3rd, 5th, 7th and 9th level.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 36
      },
      "grant": {
        "spells": [
          {
            "spell": "spell:chill-touch",
            "name": "Chill Touch",
            "casting": "at will",
            "list": "druid",
            "atWill": true
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-spores-spells-3",
      "name": "Circle Spells (3rd)",
      "summary": "Always prepared, not counted against your prepared spells: Blindness/Deafness, Gentle Repose.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 36
      },
      "grant": {
        "spells": [
          {
            "spell": "spell:blindness-deafness",
            "name": "Blindness/Deafness",
            "casting": "always prepared",
            "list": "druid"
          },
          {
            "spell": "spell:gentle-repose",
            "name": "Gentle Repose",
            "casting": "always prepared",
            "list": "druid"
          }
        ]
      }
    },
