    {
      "kind": "feature",
      "id": "feature:circle-of-spores-halo-of-spores",
      "name": "Halo of Spores",
      "summary": "Reaction when a creature you can see moves into a space within 10 ft of you or starts its turn there: it makes a Constitution save or takes necrotic damage (1d4, rising to 1d6 at 6th, 1d8 at 10th, 1d10 at 14th).",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 36
      },
      "scaling": {
        "die": {
          "class": "class:druid",
          "table": [
            [
              2,
              "1d4"
            ],
            [
              6,
              "1d6"
            ],
            [
              10,
              "1d8"
            ],
            [
              14,
              "1d10"
            ]
          ]
        }
      },
      "grant": {
        "actions": [
          {
            "id": "halo-of-spores",
            "name": "Halo of Spores",
            "economy": "reaction",
            "roll": {
              "dice": "scale.die",
              "label": "necrotic damage"
            },
            "note": "Creature within 10 ft: Con save or necrotic damage. Doubled dice while Symbiotic Entity is active."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-spores-symbiotic-entity",
      "name": "Symbiotic Entity",
      "summary": "Action: spend a Wild Shape use to gain 4 temporary hit points per druid level for 10 minutes (ends early when they run out). Meanwhile Halo of Spores rolls its die twice, and your melee weapon hits deal an extra 1d6 necrotic.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 36
      },
      "grant": {
        "actions": [
          {
            "id": "symbiotic-entity",
            "name": "Symbiotic Entity",
            "economy": "action",
            "cost": {
              "resource": "wild-shape"
            },
            "toggles": [
              "symbiotic-entity"
            ],
            "tempHp": "4*classLevel.class:druid",
            "duration": {
              "minutes": 10
            },
            "note": "4 temp HP per druid level for 10 minutes; Halo dice doubled; +1d6 necrotic on melee weapon hits."
          }
        ],
        "modifiers": [
          {
            "selector": "roll.damage.weapon.melee",
            "op": "add",
            "value": "1d6",
            "damageType": "necrotic",
            "label": "Symbiotic Entity",
            "when": {
              "toggle": "symbiotic-entity"
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:circle-of-spores-fungal-infestation",
      "name": "Fungal Infestation",
      "summary": "Reaction when a Small or Medium beast or humanoid dies within 10 ft: animate it as a zombie with 1 hit point that obeys your mental commands for 1 hour. Uses equal your Wisdom modifier (min 1) per long rest.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
