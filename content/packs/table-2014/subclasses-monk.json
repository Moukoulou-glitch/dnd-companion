    {
      "kind": "feature",
      "id": "feature:way-of-shadow-shadow-arts",
      "name": "Shadow Arts",
      "summary": "Spend 2 ki to cast Darkness, Darkvision, Pass without Trace or Silence without material components, and learn the Minor Illusion cantrip (Wisdom, ki save DC).",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 80
      },
      "grant": {
        "spellcasting": {
          "id": "shadow-arts",
          "label": "Shadow Arts",
          "ability": "wis",
          "progression": "none"
        },
        "spells": [
          {
            "spell": "spell:minor-illusion",
            "name": "Minor Illusion",
            "casting": "cantrip",
            "atWill": true
          },
          {
            "spell": "spell:darkness",
            "name": "Darkness",
            "casting": "2 ki, no slot"
          },
          {
            "spell": "spell:darkvision",
            "name": "Darkvision",
            "casting": "2 ki, no slot"
          },
          {
            "spell": "spell:pass-without-trace",
            "name": "Pass without Trace",
            "casting": "2 ki, no slot"
          },
          {
            "spell": "spell:silence",
            "name": "Silence",
            "casting": "2 ki, no slot"
          }
        ],
        "actions": [
          {
            "id": "shadow-arts",
            "name": "Shadow Arts",
            "economy": "action",
            "toggles": [],
            "note": "Cast one of the spells with ki instead of a slot.",
            "cost": {
              "resource": "ki",
              "amount": 2
            },
            "choose": {
              "label": "Spell",
              "options": [
                "Darkness",
                "Darkvision",
                "Pass without Trace",
                "Silence"
              ]
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:way-of-shadow-shadow-step",
      "name": "Shadow Step",
      "summary": "Bonus action: teleport up to 60 feet from dim light or darkness to another unoccupied space in dim light or darkness you can see, then gain advantage on your first melee attack before the end of the turn.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 80
      },
      "grant": {
        "actions": [
          {
            "id": "shadow-step",
            "name": "Shadow Step",
            "economy": "bonus",
            "toggles": [],
            "note": "Dim light/darkness to dim light/darkness, up to 60 ft. Advantage on the next melee attack this turn."
          }
        ],
        "modifiers": [
          {
            "selector": "roll.attack.weapon.melee",
            "op": "advantage",
            "mode": "suggested",
            "when": {
              "text": "first melee attack after Shadow Step this turn"
            },
            "label": "Shadow Step"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:way-of-shadow-cloak-of-shadows",
      "name": "Cloak of Shadows",
      "summary": "As an action in dim light or darkness, become invisible until you attack, cast a spell, or end your turn in bright light.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 80
      },
      "grant": {
        "actions": [
          {
            "id": "cloak-of-shadows",
            "name": "Cloak of Shadows",
            "economy": "action",
            "toggles": [
              "cloak-of-shadows"
            ],
            "note": "Invisible while in dim light or darkness; ends when you attack, cast a spell or are in bright light."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:way-of-shadow-opportunist",
      "name": "Opportunist",
      "summary": "Reaction when a creature within 5 feet of you is hit by someone else's attack: make a melee attack against it.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 80
      },
      "grant": {
        "actions": [
          {
            "id": "opportunist",
            "name": "Opportunist",
            "economy": "reaction",
            "toggles": [],
            "note": "A creature within 5 ft is hit by another's attack: one melee attack against it."
          }
        ]
      }
    },
    {
