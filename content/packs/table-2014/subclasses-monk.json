        },
        {
          "id": "brush",
          "label": "Way of the Brush",
          "kind": "tool",
          "count": 1,
          "from": [
            "Calligrapher's supplies",
            "Painter's supplies"
          ]
        }
      ],
      "grant": {
        "proficiencies": [
          {
            "kind": "weapon",
            "target": {
              "choice": "kensei-weapons"
            }
          },
          {
            "kind": "tool",
            "target": {
              "choice": "brush"
            }
          }
        ],
        "actions": [
          {
            "id": "agile-parry",
            "name": "Agile Parry",
            "economy": "free",
