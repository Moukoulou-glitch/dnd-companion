    {
      "kind": "feature",
      "id": "feature:way-of-the-four-elements-disciple-of-the-elements",
      "name": "Disciple of the Elements",
      "summary": "You know Elemental Attunement plus one elemental discipline, learning one more at 6th, 11th and 17th (and may swap one each time). Disciplines cost ki; the most ki on one discipline is 2 at 3rd, 3 at 5th, 4 at 9th, 5 at 13th, 6 at 17th. Spell disciplines use your ki save DC.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 80
      },
      "scaling": {
        "maxKi": {
          "class": "class:monk",
          "table": [
            [
              3,
              2
            ],
            [
              5,
              3
            ],
            [
              9,
              4
            ],
            [
              13,
              5
            ],
            [
              17,
              6
            ]
          ]
        }
      },
      "choices": [
        {
          "id": "disciplines",
          "label": "Elemental disciplines",
          "kind": "option",
          "count": 1,
          "countBy": "elementalDisciplines",
          "from": [
            "Breath of Winter (17th)",
            "Clench of the North Wind (6th)",
            "Eternal Mountain Defense (17th)",
            "Fangs of the Fire Snake",
            "Fist of Four Thunders",
            "Fist of Unbroken Air",
            "Flames of the Phoenix (11th)",
            "Gong of the Summit (6th)",
            "Mist Stance (11th)",
            "Ride the Wind (11th)",
            "River of Hungry Flame (17th)",
            "Rush of the Gale Spirits",
            "Shape the Flowing River",
            "Sweeping Cinder Strike",
            "Water Whip",
            "Wave of Rolling Earth (17th)"
          ]
        }
      ],
      "grant": {
        "spellcasting": {
          "id": "four-elements",
          "label": "Elemental Disciplines",
          "ability": "wis",
          "progression": "none"
        },
        "actions": [
          {
            "id": "elemental-discipline",
            "name": "Elemental Discipline",
            "economy": "action",
            "toggles": [],
            "note": "Spend the discipline's ki (extra ki raises a spell's level, up to your per-discipline cap).",
            "cost": {
              "resource": "ki",
              "amount": 1
            },
            "spendAmount": {
              "label": "Ki to spend"
            }
          },
          {
            "id": "elemental-attunement",
            "name": "Elemental Attunement",
            "economy": "action",
            "toggles": [],
            "note": "A minor elemental trick: sensory effect, light/snuff a flame, chill/warm/flavor material, or shape a small amount of earth, fire, air or mist."
          }
        ]
      }
