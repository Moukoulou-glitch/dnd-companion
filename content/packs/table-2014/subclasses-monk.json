            "shortbow",
            "sling",
            "battleaxe",
            "flail",
            "longsword",
            "morningstar",
            "rapier",
            "scimitar",
            "shortsword",
            "trident",
            "war pick",
            "warhammer",
            "whip",
            "blowgun",
            "hand crossbow"
