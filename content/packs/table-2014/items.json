      "source": {
        "pack": "table-2014",
        "book": "DMG",
        "page": 170
      },
      "category": "weapon",
      "weight": 2,
      "weapon": {
        "category": "martial",
        "kind": "melee",
        "group": "shortsword",
        "damage": "1d6",
        "damageType": "piercing",
        "properties": [
          "finesse",
          "light"
        ]
      },
      "magic": {
        "rarity": "rare"
      },
      "requiresAttunement": true,
      "grant": {
        "modifiers": [
          {
            "selector": "item.damage",
            "op": "add",
            "value": "2d6",
            "damageType": "fire",
            "label": "Flame Tongue (lit)",
            "when": {
              "toggle": "flame-tongue-lit"
            }
          }
        ],
        "actions": [
          {
            "id": "ignite-flame-tongue",
            "name": "Ignite Flame Tongue",
            "economy": "bonus",
            "toggles": [
              "flame-tongue-lit"
            ],
            "note": "Flames add 2d6 fire to its hits. Speak the word again, or drop or sheathe it, to put it out."
          }
        ]
      }
