      "name": "Find Familiar",
      "spell": "spell:find-familiar",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 240
      },
      "creatures": [
        "creature:bat",
        "creature:cat",
        "creature:crab",
        "creature:frog",
        "creature:hawk",
        "creature:lizard",
