        "creature:owl",
        "creature:poisonous-snake",
        "creature:quipper",
        "creature:rat",
        "creature:raven",
        "creature:sea-horse",
        "creature:spider",
        "creature:weasel",
        "creature:imp",
        "creature:pseudodragon",
        "creature:quasit",
        "creature:sprite"
      ],
      "count": {
        "1": 1
      },
      "initiative": "own",
      "note": "A celestial, fey or fiend spirit in the beast's form. It acts on its own initiative and can't attack, but can take other actions. Imp, pseudodragon, quasit and sprite only with Pact of the Chain. You can see through its senses (action) and cast touch spells through it (your reaction)."
    },
