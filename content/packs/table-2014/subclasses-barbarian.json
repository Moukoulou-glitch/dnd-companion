{
  "definitions": [
    {
      "kind": "subclass",
      "id": "subclass:path-of-the-totem-warrior",
      "name": "Path of the Totem Warrior",
      "summary": "Barbarian bonded to an animal spirit (Bear, Eagle or Wolf) that shapes their rage.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "class": "class:barbarian",
      "features": [
        {
          "level": 3,
          "feature": "feature:path-of-the-totem-warrior-spirit-seeker"
        },
        {
          "level": 3,
          "feature": "feature:path-of-the-totem-warrior-totem-spirit"
        },
        {
          "level": 6,
          "feature": "feature:path-of-the-totem-warrior-aspect-of-the-beast"
        },
        {
          "level": 10,
          "feature": "feature:path-of-the-totem-warrior-spirit-walker"
        },
        {
          "level": 14,
          "feature": "feature:path-of-the-totem-warrior-totemic-attunement"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-spirit-seeker",
      "name": "Spirit Seeker",
      "summary": "Cast Beast Sense and Speak with Animals, as rituals only.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "spellcasting": {
          "id": "totem-warrior-rituals",
          "label": "Totem Warrior (rituals)",
          "ability": "wis",
          "progression": "none"
        },
        "spells": [
          {
            "spell": "spell:beast-sense",
            "name": "Beast Sense",
            "casting": "ritual only"
          },
          {
            "spell": "spell:speak-with-animals",
            "name": "Speak with Animals",
            "casting": "ritual only"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-totem-spirit",
      "name": "Totem Spirit",
      "summary": "Pick a totem animal; its benefit applies while you rage. You need a physical totem object.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "choices": [
        {
          "id": "totem",
          "label": "Totem animal",
          "kind": "feature",
          "count": 1,
          "from": [
            "feature:path-of-the-totem-warrior-totem-spirit-bear",
            "feature:path-of-the-totem-warrior-totem-spirit-eagle",
            "feature:path-of-the-totem-warrior-totem-spirit-wolf"
          ]
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-totem-spirit-bear",
      "name": "Bear",
      "summary": "While raging, resistance to every damage type except psychic.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "modifiers": [
          {
            "selector": "defense.resist.acid",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.bludgeoning",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.cold",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.fire",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.force",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.lightning",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.necrotic",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.piercing",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.poison",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.radiant",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.slashing",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          },
          {
            "selector": "defense.resist.thunder",
            "op": "resist",
            "label": "Totem Spirit (Bear)",
            "when": {
              "toggle": "raging"
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-totem-spirit-eagle",
      "name": "Eagle",
      "summary": "While raging without heavy armor, others have disadvantage on opportunity attacks against you, and you can Dash as a bonus action.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "actions": [
          {
            "id": "totem-eagle-dash",
            "name": "Eagle Dash",
            "economy": "bonus",
            "dash": true,
            "note": "While raging, not in heavy armor. Opportunity attacks against you have disadvantage."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-totem-spirit-wolf",
      "name": "Wolf",
      "summary": "While raging, your friends have advantage on melee attacks against hostile creatures within 5 ft of you.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-aspect-of-the-beast",
      "name": "Aspect of the Beast",
      "summary": "Pick a totem animal (can differ from your Totem Spirit) for a lasting out-of-combat benefit.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "choices": [
        {
          "id": "aspect",
          "label": "Aspect animal",
          "kind": "feature",
          "count": 1,
          "from": [
            "feature:path-of-the-totem-warrior-aspect-bear",
            "feature:path-of-the-totem-warrior-aspect-eagle",
            "feature:path-of-the-totem-warrior-aspect-wolf"
          ]
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-aspect-bear",
      "name": "Bear",
      "summary": "Double carrying capacity; advantage on Strength checks to push, pull, lift or break things.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.check.str",
            "op": "advantage",
            "mode": "suggested",
            "label": "Aspect of the Bear",
            "when": {
              "text": "pushing, pulling, lifting or breaking objects"
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-aspect-eagle",
      "name": "Eagle",
      "summary": "See clearly up to a mile away, and dim light doesn't give disadvantage on Wisdom (Perception) checks.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.check.skill.perception",
            "op": "note",
            "label": "Aspect of the Eagle: dim light doesn't impose disadvantage; see details up to 1 mile away."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-aspect-wolf",
      "name": "Wolf",
      "summary": "Track at a fast pace and move stealthily at a normal pace while traveling.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-spirit-walker",
      "name": "Spirit Walker",
      "summary": "Cast Commune with Nature, as a ritual only.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "spells": [
          {
            "spell": "spell:commune-with-nature",
            "name": "Commune with Nature",
            "casting": "ritual only",
            "list": "totem-warrior-rituals"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-totemic-attunement",
      "name": "Totemic Attunement",
      "summary": "Pick a totem animal for a powerful benefit while raging.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "choices": [
        {
          "id": "attunement",
          "label": "Attunement animal",
          "kind": "feature",
          "count": 1,
          "from": [
            "feature:path-of-the-totem-warrior-attunement-bear",
            "feature:path-of-the-totem-warrior-attunement-eagle",
            "feature:path-of-the-totem-warrior-attunement-wolf"
          ]
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-attunement-bear",
      "name": "Bear",
      "summary": "While raging, hostile creatures within 5 ft that can see or hear you have disadvantage on attacks against anyone but you (or others with this feature).",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-attunement-eagle",
      "name": "Eagle",
      "summary": "While raging, you have a flying speed equal to your walking speed, but you fall if you end your turn in the air.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      }
    },
    {
      "kind": "feature",
      "id": "feature:path-of-the-totem-warrior-attunement-wolf",
      "name": "Wolf",
      "summary": "While raging, after hitting a Large or smaller creature with a melee weapon attack, use a bonus action to knock it prone.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 50
      },
      "grant": {
        "actions": [
          {
            "id": "totem-wolf-knockdown",
            "name": "Wolf Knockdown",
            "economy": "bonus",
            "note": "While raging, after a melee weapon hit: knock a Large or smaller creature prone."
          }
        ]
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:path-of-the-storm-herald",
