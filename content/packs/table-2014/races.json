        "feature:infernal-legacy"
      ]
    },
    {
      "kind": "feature",
      "id": "feature:infernal-legacy",
      "name": "Infernal Legacy",
      "summary": "Thaumaturgy cantrip; from 3rd level Hellish Rebuke as a 2nd-level spell once per long rest; from 5th level Darkness once per long rest. Charisma is the casting ability.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 43
      },
      "grant": {
        "spellcasting": {
          "id": "infernal-legacy",
          "label": "Infernal Legacy",
          "ability": "cha",
          "progression": "none"
        },
        "spells": [
          {
            "spell": "spell:thaumaturgy",
            "name": "Thaumaturgy",
            "casting": "At will"
          },
          {
            "spell": "spell:hellish-rebuke",
            "name": "Hellish Rebuke (2nd level)",
            "casting": "Once per long rest",
            "resource": "infernal-legacy-rebuke"
          }
        ],
        "resources": [
          {
            "id": "infernal-legacy-rebuke",
            "name": "Infernal Legacy: Hellish Rebuke",
            "max": 1,
            "reset": "long"
          }
        ],
        "actions": [
          {
            "id": "hellish-rebuke",
            "name": "Hellish Rebuke",
            "economy": "reaction",
            "cost": {
              "resource": "infernal-legacy-rebuke"
            },
            "note": "When a creature you can see within 60 ft damages you: 3d10 fire, Dexterity save for half (2nd level)."
          }
        ]
      }
    },
