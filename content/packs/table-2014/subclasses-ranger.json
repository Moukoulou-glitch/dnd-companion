    {
      "kind": "feature",
      "id": "feature:monster-slayer-slayers-prey",
      "name": "Slayer's Prey",
      "summary": "Bonus action: mark a creature within 60 ft. The first time each turn you hit it with a weapon attack it takes an extra 1d6. Lasts until a short or long rest or until you mark another creature.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 43
      },
      "grant": {
        "actions": [
          {
            "id": "slayers-prey",
            "name": "Slayer's Prey",
            "economy": "bonus",
            "toggles": [
              "slayers-prey"
            ],
            "note": "Mark a creature within 60 ft: +1d6 on your first weapon hit on it each turn."
          }
        ],
        "modifiers": [
          {
            "selector": "roll.damage.weapon.*",
            "op": "add",
            "value": "1d6",
            "mode": "suggested",
            "when": {
              "toggle": "slayers-prey",
              "text": "first hit this turn on your marked target"
            },
            "label": "Slayer's Prey",
            "oncePerTurn": true
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:monster-slayer-supernatural-defense",
      "name": "Supernatural Defense",
      "summary": "When your Slayer's Prey target forces you to make a save, or you check to escape its grapple, add 1d6 to the roll.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 43
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.save.*",
            "op": "add",
            "value": "1d6",
            "mode": "suggested",
            "when": {
              "toggle": "slayers-prey",
              "text": "your Slayer's Prey target forced the save"
            },
            "label": "Supernatural Defense"
          },
          {
            "selector": "roll.check.skill.athletics",
            "op": "add",
            "value": "1d6",
            "mode": "suggested",
            "when": {
              "toggle": "slayers-prey",
              "text": "escaping your Slayer's Prey target's grapple"
            },
            "label": "Supernatural Defense"
          },
          {
            "selector": "roll.check.skill.acrobatics",
            "op": "add",
            "value": "1d6",
            "mode": "suggested",
            "when": {
              "toggle": "slayers-prey",
