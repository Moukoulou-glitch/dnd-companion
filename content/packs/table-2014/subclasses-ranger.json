      "id": "feature:gloom-stalker-magic-3",
      "name": "Gloom Stalker Magic (3)",
      "summary": "Always known, and they don't count against your ranger spells known: Disguise Self.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "grant": {
        "spells": [
          {
            "spell": "spell:disguise-self",
            "name": "Disguise Self",
            "casting": "always known",
            "list": "ranger"
          }
        ]
      }
    },
