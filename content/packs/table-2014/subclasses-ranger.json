    {
      "kind": "feature",
      "id": "feature:gloom-stalker-dread-ambusher",
      "name": "Dread Ambusher",
      "summary": "Add your Wisdom modifier to initiative. On your first turn of each combat your speed rises by 10 ft, and if you take the Attack action you make one extra weapon attack that deals an extra 1d8 damage of the weapon's type on a hit.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.initiative",
            "op": "add",
            "value": "mod.wis",
            "label": "Dread Ambusher"
          },
          {
            "selector": "roll.damage.weapon.*",
            "op": "add",
            "value": "1d8",
            "mode": "suggested",
            "when": {
              "text": "the extra attack on your first turn of combat"
            },
            "label": "Dread Ambusher"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:gloom-stalker-umbral-sight",
      "name": "Umbral Sight",
      "summary": "Darkvision 60 ft (or 30 ft more if you already have it). While in darkness you are invisible to creatures that rely on darkvision to see you.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "grant": {
        "senses": {
          "darkvision": 60
        }
      }
    },
    {
      "kind": "feature",
      "id": "feature:gloom-stalker-iron-mind",
      "name": "Iron Mind",
      "summary": "Proficiency in Wisdom saving throws; if you already have it, pick Intelligence or Charisma saves instead.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "grant": {
        "proficiencies": [
          {
            "kind": "save",
            "target": {
              "choice": "save"
            }
          }
        ]
      },
      "choices": [
        {
          "id": "save",
          "label": "Saving throw",
          "kind": "ability",
          "count": 1,
          "from": [
            "wis",
            "int",
            "cha"
          ]
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:gloom-stalker-stalkers-flurry",
      "name": "Stalker's Flurry",
      "summary": "Once on each of your turns when you miss with a weapon attack, you can make another weapon attack as part of the same action.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.attack.weapon.*",
            "op": "note",
            "label": "Stalker's Flurry: on a miss, make another weapon attack (once per turn).",
            "oncePerTurn": true
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:gloom-stalker-shadowy-dodge",
      "name": "Shadowy Dodge",
      "summary": "Reaction: when a creature attacks you without advantage, impose disadvantage on that attack.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "grant": {
        "actions": [
          {
            "id": "shadowy-dodge",
            "name": "Shadowy Dodge",
            "economy": "reaction",
            "note": "An attack against you without advantage: it has disadvantage."
          }
        ]
      }
    },
