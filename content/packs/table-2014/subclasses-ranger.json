{
  "definitions": [
    {
      "kind": "subclass",
      "id": "subclass:gloom-stalker",
      "name": "Gloom Stalker",
      "summary": "Ranger at home in darkness who ambushes foes before they can react.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 41
      },
      "class": "class:ranger",
      "features": [
        {
          "level": 3,
          "feature": "feature:gloom-stalker-magic-3"
        },
        {
          "level": 3,
          "feature": "feature:gloom-stalker-dread-ambusher"
        },
        {
          "level": 3,
          "feature": "feature:gloom-stalker-umbral-sight"
        },
        {
          "level": 5,
          "feature": "feature:gloom-stalker-magic-5"
        },
        {
          "level": 7,
          "feature": "feature:gloom-stalker-iron-mind"
        },
        {
          "level": 9,
          "feature": "feature:gloom-stalker-magic-9"
        },
        {
          "level": 11,
          "feature": "feature:gloom-stalker-stalkers-flurry"
        },
