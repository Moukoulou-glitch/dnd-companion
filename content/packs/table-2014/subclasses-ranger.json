    {
      "kind": "feature",
      "id": "feature:horizon-walker-planar-warrior",
      "name": "Planar Warrior",
      "summary": "Bonus action: pick a creature within 30 ft. Your next hit on it this turn deals all force damage plus an extra 1d8 force (2d8 from 11th level).",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 42
      },
      "grant": {
        "actions": [
          {
            "id": "planar-warrior",
            "name": "Planar Warrior",
            "economy": "bonus",
            "note": "Choose a creature within 30 ft: your next hit on it this turn deals force damage plus extra dice."
          }
        ],
        "modifiers": [
          {
            "selector": "roll.damage.weapon.*",
            "op": "add",
            "value": "scale.dice",
            "mode": "suggested",
            "when": {
              "text": "first hit this turn on the creature marked with Planar Warrior (all the damage becomes force)"
            },
            "label": "Planar Warrior",
            "damageType": "force",
            "oncePerTurn": true
          }
        ]
      },
      "scaling": {
        "dice": {
          "class": "class:ranger",
          "table": [
            [
              3,
              "1d8"
            ],
            [
              11,
              "2d8"
            ]
          ]
        }
      }
    },
