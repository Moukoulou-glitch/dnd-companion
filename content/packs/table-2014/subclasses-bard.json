    {
      "kind": "feature",
      "id": "feature:bard-additional-bard-spells",
      "name": "Additional Bard Spells",
      "summary": "Optional (Tasha's): extra spells are added to the bard spell list (see the book's list).",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 27
      }
    },
    {
      "kind": "feature",
      "id": "feature:bard-magical-inspiration",
      "name": "Magical Inspiration",
      "summary": "Optional (Tasha's): a creature holding your Bardic Inspiration die can add it to one healing roll or one damage roll of a spell it casts, then the die is spent.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 27
      }
    },
    {
      "kind": "feature",
      "id": "feature:bard-bardic-versatility",
      "name": "Bardic Versatility",
      "summary": "Optional (Tasha's): whenever you get an Ability Score Improvement, you may swap one Expertise skill for another proficient skill, or one bard cantrip for another.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 27
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:college-of-valor",
      "name": "College of Valor",
      "summary": "Battle-ready bard whose inspiration also boosts damage and defense.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 55
      },
      "class": "class:bard",
      "features": [
        {
          "level": 3,
          "feature": "feature:college-of-valor-bonus-proficiencies"
        },
        {
          "level": 3,
          "feature": "feature:college-of-valor-combat-inspiration"
        },
        {
          "level": 6,
          "feature": "feature:college-of-valor-extra-attack"
        },
        {
          "level": 14,
          "feature": "feature:college-of-valor-battle-magic"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:college-of-valor-bonus-proficiencies",
      "name": "Bonus Proficiencies",
      "summary": "Proficiency with medium armor, shields and martial weapons.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 55
      },
      "grant": {
        "proficiencies": [
          {
            "kind": "armor",
            "target": "medium"
          },
          {
            "kind": "armor",
            "target": "shields"
          },
          {
            "kind": "weapon",
            "target": "martial"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-valor-combat-inspiration",
      "name": "Combat Inspiration",
      "summary": "A creature with your Bardic Inspiration die can also add it to a weapon damage roll, or to its AC as a reaction against one attack.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 55
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-valor-extra-attack",
      "name": "Extra Attack",
      "summary": "Attack twice when you take the Attack action.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 55
      },
      "grant": {
        "extraAttacks": 2
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-valor-battle-magic",
      "name": "Battle Magic",
      "summary": "After using your action to cast a bard spell, you can make one weapon attack as a bonus action.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 55
      },
      "grant": {
        "actions": [
          {
            "id": "battle-magic",
            "name": "Battle Magic",
            "economy": "bonus",
            "infoOnly": true,
            "note": "After casting a bard spell with your action: one weapon attack as a bonus action."
          }
        ]
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:college-of-glamour",
      "name": "College of Glamour",
      "summary": "Fey-touched bard who beguiles crowds and commands with majesty.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 14
      },
      "class": "class:bard",
      "features": [
        {
          "level": 3,
          "feature": "feature:college-of-glamour-mantle-of-inspiration"
        },
        {
          "level": 3,
          "feature": "feature:college-of-glamour-enthralling-performance"
        },
        {
          "level": 6,
          "feature": "feature:college-of-glamour-mantle-of-majesty"
        },
        {
          "level": 14,
          "feature": "feature:college-of-glamour-unbreakable-majesty"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:college-of-glamour-mantle-of-inspiration",
      "name": "Mantle of Inspiration",
      "summary": "Bonus action, spend a Bardic Inspiration: up to Charisma modifier (min 1) creatures within 60 ft gain temp HP (5, rising to 14 at 15th) and can use their reaction to move without provoking opportunity attacks.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 14
      },
      "scaling": {
        "thp": {
          "class": "class:bard",
          "table": [
            [
              3,
              5
            ],
            [
              5,
              8
            ],
            [
              10,
              11
            ],
            [
              15,
              14
            ]
          ]
        }
      },
      "grant": {
        "actions": [
          {
            "id": "mantle-of-inspiration",
            "name": "Mantle of Inspiration",
            "economy": "bonus",
            "cost": {
              "resource": "bardic-inspiration"
            },
            "roll": {
              "dice": "scale.thp",
              "label": "temp HP for each chosen creature"
            },
            "note": "Up to Cha mod creatures within 60 ft: temp HP, and each may move its speed with its reaction without provoking."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-glamour-enthralling-performance",
      "name": "Enthralling Performance",
      "summary": "After performing for at least 1 minute, up to Charisma modifier humanoids that watched make a Wisdom save or are charmed by you for an hour. Once per short or long rest.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 14
      },
      "grant": {
        "resources": [
          {
            "id": "enthralling-performance",
            "name": "Enthralling Performance",
            "max": 1,
            "reset": "short"
          }
        ],
        "actions": [
          {
            "id": "enthralling-performance",
            "name": "Enthralling Performance",
            "economy": "action",
            "cost": {
              "resource": "enthralling-performance"
            },
            "note": "After a 1-minute performance: Wisdom save or charmed for 1 hour."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-glamour-mantle-of-majesty",
      "name": "Mantle of Majesty",
      "summary": "Bonus action: for 1 minute (concentration) you can cast Command as a bonus action each turn without a slot; charmed targets fail automatically. Once per long rest, or spend a 3rd-level or higher slot.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 14
      },
      "grant": {
        "resources": [
          {
            "id": "mantle-of-majesty",
            "name": "Mantle of Majesty",
            "max": 1,
            "reset": "long"
          }
        ],
        "actions": [
          {
            "id": "mantle-of-majesty",
            "name": "Mantle of Majesty",
            "economy": "bonus",
            "cost": {
              "resource": "mantle-of-majesty"
            },
            "toggles": [
              "mantle-of-majesty"
            ],
            "duration": {
              "rounds": 10
            },
            "note": "Concentration, 1 minute. Cast Command as a bonus action each turn, no slot."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-glamour-unbreakable-majesty",
      "name": "Unbreakable Majesty",
      "summary": "Bonus action, 1 minute: a creature attacking you for the first time on a turn must make a Charisma save or pick a new target; on a success it has disadvantage on saves against your spells on your next turn. Once per short or long rest.",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 15
      },
      "grant": {
        "resources": [
          {
            "id": "unbreakable-majesty",
            "name": "Unbreakable Majesty",
            "max": 1,
            "reset": "short"
          }
        ],
        "actions": [
          {
            "id": "unbreakable-majesty",
            "name": "Unbreakable Majesty",
            "economy": "bonus",
            "cost": {
              "resource": "unbreakable-majesty"
            },
            "toggles": [
              "unbreakable-majesty"
            ],
            "duration": {
              "rounds": 10
            },
            "note": "First attack against you each turn: Charisma save or retarget."
          }
        ]
      }
    },
    {
