    {
      "kind": "feature",
      "id": "feature:college-of-creation-mote-of-potential",
      "name": "Mote of Potential",
      "summary": "Your Bardic Inspiration dice gain a bonus: on a check, roll the die twice and take either; on an attack, a hit sends a thunder burst (Con save) around the target; on a save, the creature also gains temp HP equal to the roll + your Charisma modifier.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 27
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-creation-performance-of-creation",
      "name": "Performance of Creation",
      "summary": "Action: create a nonmagical item worth up to 20 gp x bard level (Medium; Large at 6th, Huge at 14th) that lasts proficiency bonus hours. Once per long rest, or spend a 2nd-level or higher slot.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 28
      },
      "grant": {
        "resources": [
          {
            "id": "performance-of-creation",
            "name": "Performance of Creation",
            "max": 1,
            "reset": "long"
          }
        ],
        "actions": [
          {
            "id": "performance-of-creation",
            "name": "Performance of Creation",
            "economy": "action",
            "cost": {
              "resource": "performance-of-creation"
            },
            "note": "Create an item worth up to 20 gp x bard level; lasts proficiency bonus hours. Or spend a 2nd+ slot instead."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-creation-animating-performance",
      "name": "Animating Performance",
