    {
      "kind": "feature",
      "id": "feature:college-of-swords-blade-flourish",
      "name": "Blade Flourish",
      "summary": "When you take the Attack action, your walking speed rises by 10 ft that turn. Once per turn on a weapon hit, spend a Bardic Inspiration for a flourish: Defensive (die to damage and to AC until your next turn), Slashing (die to the target and another creature within 5 ft), or Mobile (die to damage and push the target 5 + die ft).",
      "source": {
        "pack": "table-2014",
        "book": "XGtE",
        "page": 15
      },
      "scaling": {
        "die": {
          "class": "class:bard",
          "table": [
            [
              1,
              "d6"
            ],
            [
              5,
              "d8"
            ],
            [
              10,
              "d10"
            ],
            [
              15,
              "d12"
            ]
          ]
        }
      },
      "grant": {
        "actions": [
          {
            "id": "blade-flourish",
            "name": "Blade Flourish",
            "economy": "free",
            "cost": {
              "resource": "bardic-inspiration"
            },
            "roll": {
              "dice": "scale.die",
              "label": "flourish die"
            },
            "choose": {
              "label": "Flourish",
              "options": [
                "Defensive Flourish",
                "Slashing Flourish",
                "Mobile Flourish"
              ]
            },
            "note": "Once per turn, on a weapon hit during the Attack action."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:college-of-swords-extra-attack",
