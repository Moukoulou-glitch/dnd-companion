    {
      "kind": "feature",
      "id": "feature:sneak-attack",
      "name": "Sneak Attack",
      "summary": "Once per turn, extra damage on a hit with a finesse or ranged weapon when you have advantage, or when another enemy of the target is within 5 ft of it and you don't have disadvantage.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 96
      },
      "scaling": {
        "dice": {
          "class": "class:rogue",
          "table": [
            [
              1,
              "1d6"
            ],
            [
              3,
              "2d6"
            ],
            [
              5,
              "3d6"
            ],
            [
              7,
              "4d6"
            ],
            [
              9,
              "5d6"
            ],
            [
              11,
              "6d6"
            ],
            [
              13,
              "7d6"
            ],
            [
              15,
              "8d6"
            ],
            [
              17,
              "9d6"
            ],
            [
              19,
              "10d6"
            ]
          ]
        }
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.damage.weapon.*",
            "op": "add",
            "value": "scale.dice",
            "mode": "suggested",
            "label": "Sneak Attack",
            "when": {
              "text": "once per turn; finesse or ranged weapon; advantage, or an ally within 5 ft of the target"
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:thieves-cant",
      "name": "Thieves' Cant",
      "summary": "Secret rogue jargon and signs.",
