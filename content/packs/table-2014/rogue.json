        "book": "PHB",
        "page": 96
      },
      "grant": {
        "proficiencies": [
          {
            "kind": "language",
            "target": "Thieves' Cant"
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:cunning-action",
      "name": "Cunning Action",
      "summary": "Dash, Disengage or Hide as a bonus action.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 96
      },
      "grant": {
        "actions": [
          {
            "id": "cunning-action",
            "name": "Cunning Action",
            "economy": "bonus",
            "note": "Dash, Disengage or Hide."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:steady-aim",
      "name": "Steady Aim",
      "summary": "Bonus action, if you haven't moved this turn: advantage on your next attack this turn, and your speed becomes 0 until the turn ends.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 62
      },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.attack.*",
            "op": "advantage",
            "mode": "suggested",
            "label": "Steady Aim",
            "when": {
              "text": "bonus action, not moved this turn; speed becomes 0"
            }
          }
        ],
        "actions": [
          {
            "id": "steady-aim",
            "name": "Steady Aim",
            "economy": "bonus",
            "note": "Only if you haven't moved this turn: advantage on your next attack this turn; your speed becomes 0.",
            "notAfterMoving": true,
            "stopsMovement": true
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:uncanny-dodge",
      "name": "Uncanny Dodge",
      "summary": "Reaction: halve the damage of an attack that hits you from an attacker you can see.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 96
      },
      "grant": {
        "actions": [
          {
            "id": "uncanny-dodge",
            "name": "Uncanny Dodge",
            "economy": "reaction",
            "note": "When an attacker you can see hits you: halve the damage."
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:evasion",
      "name": "Evasion",
      "summary": "Dexterity saves for half damage: no damage on a success, half on a failure.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 96
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:soulknife",
      "name": "Soulknife",
      "summary": "Rogue who fights with blades of psychic energy.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 63
      },
      "class": "class:rogue",
      "features": [
        {
          "level": 3,
          "feature": "feature:psionic-power"
        },
        {
          "level": 3,
          "feature": "feature:psychic-blades"
        },
        {
          "level": 9,
          "feature": "feature:soul-blades"
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:psionic-power",
      "name": "Psionic Power",
      "summary": "A pool of Psionic Energy dice (twice your proficiency bonus) fueling Psi-Bolstered Knack and Psychic Whispers. Regain all on a long rest; regain one as a bonus action once per short rest.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 63
      },
      "scaling": {
        "die": {
          "class": "class:rogue",
          "table": [
            [
              3,
              "1d6"
            ],
            [
              5,
              "1d8"
            ],
            [
              11,
              "1d10"
            ],
            [
              17,
              "1d12"
            ]
          ]
        }
      },
      "grant": {
        "resources": [
          {
            "id": "psionic-energy",
            "name": "Psionic Energy dice",
            "max": "pb + pb",
            "reset": "long",
            "die": "scale.die"
          },
          {
            "id": "psionic-recover",
            "name": "Regain a Psionic Energy die",
            "max": 1,
            "reset": "long"
          }
        ],
        "actions": [
          {
            "id": "psi-bolstered-knack",
            "name": "Psi-Bolstered Knack",
            "economy": "free",
            "toggles": [],
            "roll": {
              "dice": "scale.die",
              "label": "added to the failed check"
            },
            "note": "After failing a check with a skill or tool you're proficient in: add a Psionic Energy die. Spend the die only if the check now succeeds."
          },
          {
            "id": "psychic-whispers",
            "name": "Psychic Whispers",
            "economy": "action",
            "toggles": [],
            "cost": {
              "resource": "psionic-energy",
              "amount": 1
            },
            "roll": {
              "dice": "scale.die",
              "label": "hours of telepathy"
            },
            "duration": {
              "fromRoll": "hours"
            },
            "note": "Telepathy with up to PB creatures you can see, for hours equal to the roll. The first use after each long rest costs no die: use Just activate."
          },
          {
            "id": "psionic-recover",
            "name": "Regain a Psionic Energy die",
            "economy": "bonus",
            "toggles": [],
            "note": "Bonus action: regain one spent Psionic Energy die. Once per long rest (table ruling).",
            "cost": {
              "resource": "psionic-recover",
              "amount": 1
            },
            "restores": {
              "resource": "psionic-energy",
              "amount": 1
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:psychic-blades",
      "name": "Psychic Blades",
      "summary": "When you take the Attack action, attack with a psychic blade (simple melee, finesse, thrown 60 ft). Then a second blade as a bonus action with a d4.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 64
      },
      "grant": {
        "attacks": [
          {
            "id": "attack:psychic-blade",
            "name": "Psychic Blade",
            "category": "simple",
            "kind": "melee",
            "damage": "1d6",
            "damageType": "psychic",
            "properties": [
              "finesse",
              "thrown"
            ],
            "range": [
              60,
              60
            ]
          },
          {
            "id": "attack:psychic-blade-bonus",
            "name": "Psychic Blade (bonus action)",
            "category": "simple",
            "kind": "melee",
            "damage": "1d4",
            "damageType": "psychic",
            "properties": [
              "finesse",
              "thrown"
            ],
            "range": [
              60,
              60
            ],
            "action": "bonus",
            "requires": {
              "attack": "attack:psychic-blade",
              "text": "The second Psychic Blade comes after you've attacked with a Psychic Blade this turn (Attack action), with your other hand free."
            }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:soul-blades",
      "name": "Soul Blades",
      "summary": "Spend Psionic Energy dice to turn a Psychic Blade miss into a hit, or to teleport by throwing a blade.",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 64
      }
    }
  ]
}
