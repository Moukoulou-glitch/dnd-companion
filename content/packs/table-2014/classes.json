    {
      "kind": "feature",
      "id": "feature:favored-foe",
      "name": "Favored Foe",
      "summary": "On a hit, mark the target for 1 minute (concentration). Once per turn, the first hit on it deals extra damage (1d4, rising at 6th and 14th level).",
      "source": {
        "pack": "table-2014",
        "book": "TCoE",
        "page": 56
      },
      "grant": {
        "resources": [
          {
            "id": "favored-foe",
            "name": "Favored Foe",
            "max": "pb",
            "reset": "long"
          }
        ],
        "actions": [
          {
            "id": "favored-foe",
            "name": "Favored Foe",
            "economy": "free",
            "cost": {
              "resource": "favored-foe"
            },
            "toggles": [
              "favored-foe"
            ],
            "note": "When you hit: mark the target for 1 minute (concentration). Once per turn, your first hit on it adds 1d4.",
            "duration": {
              "rounds": 10
            }
          }
        ],
        "modifiers": [
          {
            "selector": "roll.damage.weapon.*",
            "op": "add",
            "value": "1d4",
            "label": "Favored Foe",
            "when": {
              "toggle": "favored-foe",
              "text": "first hit on the marked target this turn"
            },
            "oncePerTurn": true
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:deft-explorer",
      "name": "Deft Explorer: Canny",
