    {
      "kind": "effect",
      "id": "condition:blinded",
      "name": "Blinded",
      "category": "condition",
      "summary": "You can't see.",
      "source": {
        "pack": "table-2014",
        "book": "PHB",
        "page": 290
      },
      "modifiers": [
        {
          "selector": "roll.attack.*",
          "op": "disadvantage"
