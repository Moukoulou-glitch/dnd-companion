{
  "id": "table-2014",
  "title": "Giorgos's table (2014 rules)",
  "ruleset": "5e-2014",
  "license": "Private to the group. Mechanics only; summaries are written in our own words, never copied book text.",
  "visibility": "private",
  "definitions": [
    {
      "kind": "class",
      "id": "class:ranger",
      "name": "Ranger",
      "summary": "Wilderness warrior and half caster using Wisdom. This table uses the Tasha's optional features (Favored Foe, Deft Explorer, Primal Awareness).",
      "source": { "pack": "table-2014", "book": "PHB", "page": 89 },
      "hitDie": 10,
      "saves": ["str", "dex"],
      "startingGrant": {
        "proficiencies": [
          { "kind": "armor", "target": "light" },
          { "kind": "armor", "target": "medium" },
          { "kind": "armor", "target": "shields" },
          { "kind": "weapon", "target": "simple" },
          { "kind": "weapon", "target": "martial" },
          { "kind": "skill", "target": { "choice": "skills" } }
        ]
      },
      "multiclassGrant": {
        "proficiencies": [
          { "kind": "armor", "target": "light" },
          { "kind": "armor", "target": "medium" },
          { "kind": "armor", "target": "shields" },
          { "kind": "weapon", "target": "simple" },
          { "kind": "weapon", "target": "martial" }
        ]
      },
      "spellcasting": { "id": "ranger", "label": "Ranger", "ability": "wis", "progression": "half" },
      "spellcastingFromLevel": 2,
      "subclassLevel": 3,
      "features": [
        { "level": 1, "feature": "feature:favored-foe" },
        { "level": 1, "feature": "feature:deft-explorer" },
        { "level": 2, "feature": "feature:fighting-style-ranger" },
        { "level": 3, "feature": "feature:primal-awareness" }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:favored-foe",
      "name": "Favored Foe",
      "summary": "On a hit, mark the target for 1 minute (concentration). Once per turn, the first hit on it deals extra damage (1d4, rising at 6th and 14th level).",
      "source": { "pack": "table-2014", "book": "TCoE", "page": 56 },
      "grant": {
        "resources": [{ "id": "favored-foe", "name": "Favored Foe", "max": "pb", "reset": "long" }]
      }
    },
    {
      "kind": "feature",
      "id": "feature:deft-explorer",
      "name": "Deft Explorer: Canny",
      "summary": "Expertise in one skill you are proficient in, and two extra languages.",
      "source": { "pack": "table-2014", "book": "TCoE", "page": 56 },
      "choices": [
        { "id": "canny-skill", "label": "Expertise skill", "kind": "skill", "count": 1 },
        { "id": "canny-languages", "label": "Languages", "kind": "language", "count": 2 }
      ],
      "grant": {
        "proficiencies": [
          { "kind": "expertise", "target": { "choice": "canny-skill" } },
          { "kind": "language", "target": { "choice": "canny-languages" } }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:fighting-style-ranger",
      "name": "Fighting Style",
      "summary": "Pick one fighting style.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 91 },
      "choices": [
        {
          "id": "style",
          "label": "Fighting style",
          "kind": "feature",
          "count": 1,
          "from": ["feature:style-archery"]
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:style-archery",
      "name": "Archery",
      "summary": "+2 to attack rolls with ranged weapons.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 72 },
      "grant": {
        "modifiers": [{ "selector": "roll.attack.weapon.ranged", "op": "add", "value": 2, "label": "Archery" }]
      }
    },
    {
      "kind": "feature",
      "id": "feature:primal-awareness",
      "name": "Primal Awareness",
      "summary": "Learn extra spells at certain ranger levels (Speak with Animals at 3rd); each can be cast once per long rest without a slot.",
      "source": { "pack": "table-2014", "book": "TCoE", "page": 57 },
      "grant": {
        "spells": [
          {
            "spell": "spell:speak-with-animals",
            "name": "Speak with Animals",
            "casting": "Free once per long rest, or with a ranger slot",
            "resource": "primal-awareness-speak-with-animals"
          }
        ],
        "resources": [
          {
            "id": "primal-awareness-speak-with-animals",
            "name": "Primal Awareness: Speak with Animals",
            "max": 1,
            "reset": "long"
          }
        ]
      }
    },
    {
      "kind": "subclass",
      "id": "subclass:beast-master",
      "name": "Beast Master",
      "summary": "A primal beast companion fights alongside the ranger.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 93 },
      "class": "class:ranger",
      "features": [{ "level": 3, "feature": "feature:primal-companion" }]
    },
    {
      "kind": "feature",
      "id": "feature:primal-companion",
      "name": "Primal Companion",
      "summary": "Summon a Beast of the Land, Sea or Sky that scales with proficiency bonus. It Dodges unless commanded with a bonus action, or in place of one of your attacks.",
      "source": { "pack": "table-2014", "book": "TCoE", "page": 61 }
    },
    {
      "kind": "race",
      "id": "race:eladrin",
      "name": "Eladrin",
      "summary": "Fey elf tied to the seasons. Darkvision, trance, and a short-range teleport.",
      "source": { "pack": "table-2014", "book": "MToF", "page": 61 },
      "size": "medium",
      "speed": 30,
      "grant": {
        "abilityBonuses": { "dex": 2, "cha": 1 },
        "senses": { "darkvision": 60 },
        "proficiencies": [
          { "kind": "language", "target": "Common" },
          { "kind": "language", "target": "Elvish" }
        ]
      },
      "features": ["feature:keen-senses", "feature:fey-ancestry", "feature:trance", "feature:fey-step"]
    },
    {
      "kind": "feature",
      "id": "feature:keen-senses",
      "name": "Keen Senses",
      "summary": "Proficiency in Perception.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 23 },
      "grant": { "proficiencies": [{ "kind": "skill", "target": "perception" }] }
    },
    {
      "kind": "feature",
      "id": "feature:fey-ancestry",
      "name": "Fey Ancestry",
      "summary": "Advantage on saves against being charmed; magic can't put you to sleep.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 23 },
      "grant": {
        "modifiers": [
          {
            "selector": "roll.save.*",
            "op": "advantage",
            "label": "Fey Ancestry",
            "when": { "text": "against being charmed" }
          }
        ]
      }
    },
    {
      "kind": "feature",
      "id": "feature:trance",
      "name": "Trance",
      "summary": "Meditate 4 hours instead of sleeping; a long rest takes 4 hours.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 23 }
    },
    {
      "kind": "feature",
      "id": "feature:fey-step",
      "name": "Fey Step (Summer)",
      "summary": "Bonus action: teleport up to 30 ft. From 3rd level, Summer adds fire damage equal to your Charisma modifier (minimum 1) to creatures of your choice within 5 ft after the step.",
      "source": { "pack": "table-2014", "book": "MToF", "page": 62 },
      "grant": {
        "resources": [{ "id": "fey-step", "name": "Fey Step", "max": 1, "reset": "short" }]
      }
    },
    {
      "kind": "feat",
      "id": "feat:magic-initiate",
      "name": "Magic Initiate",
      "summary": "Two cantrips and one 1st-level spell from one class's list; the 1st-level spell is free once per long rest.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 168 },
      "features": [],
      "choices": [
        {
          "id": "class",
          "label": "Spell list",
          "kind": "feature",
          "count": 1,
          "from": ["feature:magic-initiate-cleric"]
        }
      ]
    },
    {
      "kind": "feature",
      "id": "feature:magic-initiate-cleric",
      "name": "Magic Initiate (Cleric)",
      "summary": "Cleric spells cast with Wisdom.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 168 },
      "choices": [
        { "id": "cantrips", "label": "Cantrips", "kind": "spell", "count": 2 },
        { "id": "spell", "label": "1st-level spell", "kind": "spell", "count": 1 }
      ],
      "grant": {
        "spellcasting": { "id": "magic-initiate-cleric", "label": "Magic Initiate (Cleric)", "ability": "wis", "progression": "none" },
        "resources": [{ "id": "magic-initiate-spell", "name": "Magic Initiate: free 1st-level spell", "max": 1, "reset": "long" }]
      }
    },
    {
      "kind": "item",
      "id": "item:leather-armor",
      "name": "Leather Armor",
      "source": { "pack": "table-2014", "book": "PHB", "page": 145 },
      "category": "armor",
      "weight": 10,
      "armor": { "category": "light", "base": 11 }
    },
    {
      "kind": "item",
      "id": "item:shortsword",
      "name": "Shortsword",
      "source": { "pack": "table-2014", "book": "PHB", "page": 149 },
      "category": "weapon",
      "weight": 2,
      "weapon": {
        "category": "martial",
        "kind": "melee",
        "group": "shortsword",
        "damage": "1d6",
        "damageType": "piercing",
        "properties": ["finesse", "light"]
      }
    },
    {
      "kind": "item",
      "id": "item:vicious-longbow",
      "name": "Vicious Longbow",
      "summary": "On a natural 20 attack roll, the target takes 7 extra damage of the weapon's type.",
      "source": { "pack": "table-2014", "book": "DMG", "page": 209 },
      "category": "weapon",
      "weight": 2,
      "weapon": {
        "category": "martial",
        "kind": "ranged",
        "group": "longbow",
        "damage": "1d8",
        "damageType": "piercing",
        "properties": ["ammunition", "heavy", "two-handed"],
        "range": [150, 600]
      },
      "magic": { "rarity": "rare" },
      "grant": {
        "modifiers": [{ "selector": "item.damage", "op": "critBonusDamage", "value": 7, "label": "Vicious (natural 20)" }]
      }
    },
    {
      "kind": "item",
      "id": "item:arrows",
      "name": "Arrows",
      "source": { "pack": "table-2014", "book": "PHB", "page": 150 },
      "category": "ammunition",
      "weight": 0.05
    },
    {
      "kind": "item",
      "id": "item:silvered-arrows",
      "name": "Silvered Arrows",
      "source": { "pack": "table-2014", "book": "PHB", "page": 148 },
      "category": "ammunition",
      "weight": 0.05
    },
    {
      "kind": "item",
      "id": "item:natures-mantle",
      "name": "Nature's Mantle",
      "summary": "Druid or ranger spellcasting focus. While in light obscurement you can Hide as a bonus action, even while observed.",
      "source": { "pack": "table-2014", "book": "TCoE", "page": 129 },
      "category": "wondrous",
      "magic": { "rarity": "uncommon" },
      "requiresAttunement": true
    },
    {
      "kind": "item",
      "id": "item:chime-of-opening",
      "name": "Chime of Opening",
      "summary": "Strike it to open one lock or latch within 120 ft; limited charges.",
      "source": { "pack": "table-2014", "book": "DMG", "page": 158 },
      "category": "wondrous",
      "magic": { "rarity": "rare" }
    },
    {
      "kind": "item",
      "id": "item:druidic-focus",
      "name": "Druidic Focus",
      "source": { "pack": "table-2014", "book": "PHB", "page": 151 },
      "category": "focus"
    },
    {
      "kind": "item",
      "id": "item:explorers-gear",
      "name": "Adventuring gear",
      "summary": "Backpack, bedroll, mess kit, tinderbox, torches, rations, waterskin, rope, quiver.",
      "source": { "pack": "table-2014", "book": "PHB", "page": 151 },
      "category": "gear"
    }
  ]
}
